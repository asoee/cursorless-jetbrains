<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.asoee.cursorlessjetbrains</id>
    <name>talon-cursorless-everywhere</name>
    <vendor>asoee</vendor>

    <depends>com.intellij.modules.platform</depends>
    <!-- The terminal's shell, for editing keys sent to it; without the Terminal plugin the rest still loads -->
    <depends optional="true" config-file="cursorless-terminal.xml">org.jetbrains.plugins.terminal</depends>
    <!-- The Cursorless tool window (tutorial sidebar) needs JCEF; without it the rest of the plugin still loads -->
    <depends optional="true" config-file="cursorless-jcef.xml">com.intellij.modules.jcef</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">

        <editorFactoryListener
                implementation="com.github.asoee.cursorlessjetbrains.listeners.TalonEditorFactoryListener"/>

        <notificationGroup id="vc-idea" displayType="BALLOON"/>
        <!-- Engine messages and command errors, apart from vc-idea's startup notices so silencing those keeps these -->
        <notificationGroup id="Cursorless" displayType="BALLOON"/>

        <applicationService
                serviceImplementation="com.github.asoee.cursorlessjetbrains.settings.TalonSettings"/>

        <applicationService
                serviceImplementation="com.github.asoee.cursorlessjetbrains.settings.CursorlessKeyValueStore"/>

        <postStartupActivity
                implementation="com.github.asoee.cursorlessjetbrains.listeners.TalonProjectActivity"/>

        <applicationConfigurable
                parentId="tools"
                instance="com.github.asoee.cursorlessjetbrains.settings.TalonSettingsConfigurable"
                id="com.github.asoee.cursorlessjetbrains.settings.AppSettingsConfigurable"
                displayName="Talon / Cursorless"/>
    </extensions>

    <actions>
        <action
                id="com.github.asoee.cursorlessjetbrains.action.FileCommandServerCheckAction"
                class="com.github.asoee.cursorlessjetbrains.action.FileCommandServerCheckAction"
                text="Check File Command Server"
                description="Check File Command Server">
            <!--            <override-text place="MainMenu" text="Popup Dialog Action"/>-->
            <keyboard-shortcut
                    keymap="$default"
                    first-keystroke="control shift F17"/>
            <add-to-group group-id="ToolsMenu" anchor="first"/>
        </action>
        <action id="ListAllActions" class="com.github.asoee.cursorlessjetbrains.action.ListAllActions"
                text="List All Actions" />

        <action id="cursorlessjetbrains.CursorlessToggle"
                class="com.github.asoee.cursorlessjetbrains.action.CursorlessToggleCommand"
                text="Cursorless Toggle"
                description="Toggle cursorless hats"/>

        <!-- Cursorless's git actions ("git stage", "git unstage", "git accept"), on the caret or selection -->
        <action id="Cursorless.GitStageFile" class="com.github.asoee.cursorlessjetbrains.action.GitStageFileAction"
                text="Cursorless: Git Stage File" description="Stage the whole file (git add)"/>
        <action id="Cursorless.GitUnstageFile" class="com.github.asoee.cursorlessjetbrains.action.GitUnstageFileAction"
                text="Cursorless: Git Unstage File" description="Unstage the whole file"/>
        <action id="Cursorless.GitStageLines" class="com.github.asoee.cursorlessjetbrains.action.GitStageLinesAction"
                text="Cursorless: Git Stage Selected Lines" description="Stage only the changes on the selected lines"/>
        <action id="Cursorless.GitUnstageLines" class="com.github.asoee.cursorlessjetbrains.action.GitUnstageLinesAction"
                text="Cursorless: Git Unstage Selected Lines" description="Unstage only the staged changes on the selected lines"/>
        <action id="Cursorless.GitRevertLines" class="com.github.asoee.cursorlessjetbrains.action.GitRevertLinesAction"
                text="Cursorless: Git Revert Selected Lines" description="Put the selected lines' unstaged changes back to the staged version"/>
        <action id="Cursorless.AcceptConflictSide" class="com.github.asoee.cursorlessjetbrains.action.AcceptConflictSideAction"
                text="Cursorless: Accept Conflict Side at Caret" description="Keep the side of the merge conflict the caret is in"/>
    </actions>

    <projectListeners>
        <listener
                class="com.github.asoee.cursorlessjetbrains.settings.TalonSettingsChangeListener"
                topic="com.github.asoee.cursorlessjetbrains.settings.TalonSettingsListener"/>
    </projectListeners>


</idea-plugin>
